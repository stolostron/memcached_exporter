{
  "baseBranchPatterns": [
    "/^release-\\d+\\.\\d+/"
  ],
  "gomod": {
    "updatePinnedDependencies": false
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "autoApprove": true,
  "tekton": {
    "automerge": true,
    "automergeStrategy": "rebase",
    "automergeType": "pr",
    "enabled": true,
    "platformAutomerge": true
  }
}
